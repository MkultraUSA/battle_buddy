# Battle Buddy example configuration
# Copy this file to config.env and edit locally.
# Never commit config.env or any file containing real credentials.

# Paths
BATTLE_BUDDY_HOME=/opt/battlebuddy
BATTLE_BUDDY_LOG_DIR=/var/log/battlebuddy
BATTLE_BUDDY_DATA_DIR=/var/lib/battlebuddy
BATTLE_BUDDY_WEB_DIR=/var/www/battlebuddy

# Flask / service
BATTLE_BUDDY_HOST=0.0.0.0
BATTLE_BUDDY_PORT=9001
FLASK_ENV=production

# HTTP / TLS
# Keep false for production. Only set true temporarily on isolated lab systems
# with self-signed certificates or broken local certificate chains.
ALLOW_INSECURE_TLS=false

# Database and local data
DB_PATH=/opt/battlebuddy/calls.db
TGID_TSV=/opt/battlebuddy/gatrrs-tags.tsv
TIPS_UPLOAD_DIR=/opt/battlebuddy/static/tips

# Radio / OP25 capture node
PI1_OP25_URL=http://radio-node.example.local:8080/
PI_FETCH_URL=http://radio-node.example.local:9000
PI_FETCH_TOKEN=replace_with_random_token

# LLM providers. Only set the providers you actually use.
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
GROQ_API_KEY=your_groq_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Transcription
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Nextcloud Talk / Deck / WebDAV
# Disabled by default in code unless TALK_ENABLED=true and valid endpoints are set.
TALK_ENABLED=false
TALK_BASE=https://nextcloud.example.com/ocs/v2.php/apps/spreed/api/v1
TALK_USER=battlebuddy
TALK_PASS=your_nextcloud_app_password_here
TALK_BOT_SECRET=replace_with_random_secret
NC_WEBDAV=https://nextcloud.example.com/remote.php/dav/files/username
NC_USER=your_nextcloud_user_here
NC_PASS=your_nextcloud_app_password_here
DECK_BASE=https://nextcloud.example.com/index.php/apps/deck/api/v1.0
DECK_BOARD_ID=0
DECK_STACK_NEW=0

# Mail / notifications
MAILGUN_API_KEY=your_mailgun_key_here
MAILGUN_DOMAIN=mg.example.com
ALERT_EMAIL=alerts@example.com

# Maps / geocoding
GOOGLE_CSE_API_KEY=your_google_cse_key_here
GOOGLE_CSE_ID=your_google_cse_id_here
GOOGLE_ROUTES_KEY=your_google_routes_key_here
GOOGLE_MAPS_JS_KEY=your_google_maps_js_key_here

# TAK / FreeTAKServer
FTS_HOST=tak.example.local
FTS_REST_PORT=19023
FTS_COT_PORT=8089
FTS_TOKEN=replace_with_tak_token
FTS_ENABLED=false

# Stripe / payments, optional
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me
STRIPE_PRICE_ID_PREMIUM=price_replace_me
STRIPE_PRICE_ID_BASIC=price_replace_me
